# Backend origin only — do NOT append /api.
# The admin client calls paths such as /api/admin/users, so including "/api"
# here would produce /api/api/admin/users.
NEXT_PUBLIC_BACKEND_API_BASE_URL="http://localhost:4000"

# Supabase Auth / Database
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="ey..."

# Heatmap tiles come from OpenStreetMap, so no map API key is required.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your-gmaps-web-key"
