# API Base URLs
# Optional global override (origin or a URL ending in /api). Normally leave empty.
BACKEND_API_BASE_URL=""
# auto selects Linux or Android emulator; use android-device for a USB phone.
BACKEND_TARGET="auto"
BACKEND_LINUX_URL="http://localhost:4000"
BACKEND_ANDROID_EMULATOR_URL="http://10.0.2.2:4000"
BACKEND_ANDROID_DEVICE_URL="http://localhost:4000" # USB: adb reverse tcp:4000 tcp:4000
FAYDA_BROWSER_BASE_URL="" # Normally inherit the selected backend origin

# Supabase Auth / Database (Get from frontend lead)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="ey..."

# Google Maps (For Map views and location picking)
GOOGLE_MAPS_API_KEY="your-gmaps-mobile-key"
