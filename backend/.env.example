# dummy strings will be replaced with actual values in production. Do not commit sensitive information to version control.
# ask your team for the actual values and replace them in your local .env file.

# Node.js Express Server Port
PORT=4000
NODE_ENV=development
# Prototype checkout lifetime. External/ambiguous payments require reconciliation.
PENDING_PAYMENT_TIMEOUT_SECONDS=1800
# Opt in only for local/development/demo use. NODE_ENV must be development,
# demo or test. Production always rejects payment simulation, even if enabled.
SIMULATED_PAYMENTS_ENABLED=false
# Opt-in identity/role diagnostics: IDs and route/status only, never credentials.
AUTH_DIAGNOSTICS=false

# Database (Supabase PostgreSQL Connection String)
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/postgres"

# Supabase Auth / API Keys (Get from Dashboard)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="ey..."

# Auth Secret for JWT verification
JWT_SECRET="your-super-secret-jwt-key"

# Telebirr Sandbox API Keys
TELEBIRR_API_KEY="your-telebirr-key"
TELEBIRR_MERCHANT_ID="your-merchant-id"

# CBE Birr Sandbox API Key
CBE_BIRR_API_KEY="your-cbe-key"


# External Data APIs
NMIS_API_URL="https://api.nmis.gov.et"
NMA_API_KEY="your-nma-weather-key"
OPENWEATHER_API_KEY="your-openweather-key"

# SMS Gateway (for offline mode fallback notifications)
SMS_GATEWAY_API_KEY="your-sms-gateway-key"

# Google Maps (Admin Heatmaps/Backend Geo)
GOOGLE_MAPS_SERVER_KEY="your-gmaps-server-key"

# Fayda / VeriFayda 2.0 (eSignet)
FAYDA_MODE=mock
FAYDA_CLIENT_ID=mock-client-id
FAYDA_REDIRECT_URI=http://localhost:4000/api/auth/fayda/callback
FAYDA_SCOPE=openid profile email
# Base64-encoded JSON of RSA private key (only needed when mode=sandbox/production)
FAYDA_PRIVATE_KEY_BASE64=
FAYDA_MOCK_BASE_URL=http://localhost:4000/api/auth/fayda/mock
# Sandbox/Prod endpoints (leave empty if mock)
FAYDA_AUTHORIZATION_ENDPOINT=
FAYDA_TOKEN_ENDPOINT=
FAYDA_USERINFO_ENDPOINT=
FAYDA_ACR_VALUES=
FAYDA_CLAIMS_LOCALES=
### Virtual wallets (never enable in production; no real deposits/withdrawals)
DEMO_WALLETS_ENABLED=false
DEMO_WALLET_MAX_TOP_UP=1000000.00
DEMO_WALLET_MAX_BALANCE=5000000.00
DEMO_WALLET_TOP_UPS_PER_HOUR=10
